{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "graphite",
  "colors": {
    "chrome": "#101012",
    "canvas": "#121214",
    "surface": "#121214",
    "popover": "#18181b",
    "raised": "#242328",
    "hover": "#1a1a1d",
    "selected": "#2c2838",
    "border": "#1e1e20",
    "input": "#161618",
    "muted": "#8a898e",
    "dim": "#56555b",
    "accent": "#b4a0db",
    "accent_foreground": "#0f0f11",
    "solid": "#b4a0db",
    "solid_foreground": "#0f0f11",
    "working": "#8f7fd1",
    "blocked": "#ffb406",
    "done": "#53cf91",
    "idle": "#56555b",
    "unknown": "#56555b",
    "background": "#121214",
    "foreground": "#e4e4e7",
    "selection": "#3a3150",
    "ansi0": "#1a1a1d",
    "ansi1": "#e0707f",
    "ansi2": "#53cf91",
    "ansi3": "#e6c35c",
    "ansi4": "#6fb3f2",
    "ansi5": "#a690e8",
    "ansi6": "#3ec9b4",
    "ansi7": "#c8c8cc",
    "ansi8": "#56555b",
    "ansi9": "#f08a97",
    "ansi10": "#7ee0ad",
    "ansi11": "#f0d27a",
    "ansi12": "#93c7f7",
    "ansi13": "#bfaef0",
    "ansi14": "#6fdccb",
    "ansi15": "#f4f4f5"
  },
  "font": "JetBrains Mono",
  "ui_font": "Geist",
  "background": "#121214",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "#1e1e20"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "aven-panel-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 6,
                  "background": "#121214",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "#1e1e20"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#625187"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "aven",
                      "type": "block",
                      "content": {
                        "mod": "aven-panel",
                        "props": {
                          "workspace": "default"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
