{
  "global": {
    "ctrl-shift-a": "mod.open:aven-tasks",
    "ctrl-shift-u": "mod.open:aven-tasks",
    "ctrl-shift-h": "mod.open:aven-kanban"
  },
  "mod:aven-tasks": {
    "o": "aven-tasks.open",
    "a": "aven-tasks.add",
    "k": "aven-tasks.kanban",
    "r": "aven-tasks.refresh",
    "escape": "aven-tasks.close"
  },
  "mod:aven-kanban": {
    "j": "aven-kanban.next",
    "down": "aven-kanban.next",
    "k": "aven-kanban.previous",
    "up": "aven-kanban.previous",
    "h": "aven-kanban.column-previous",
    "left": "aven-kanban.column-previous",
    "l": "aven-kanban.column-next",
    "right": "aven-kanban.column-next",
    "tab": "aven-kanban.column-next",
    "shift-tab": "aven-kanban.column-previous",
    "g": "aven-kanban.first",
    "shift-g": "aven-kanban.last",
    "home": "aven-kanban.first",
    "end": "aven-kanban.last",
    "1": "aven-kanban.column-1",
    "2": "aven-kanban.column-2",
    "3": "aven-kanban.column-3",
    "4": "aven-kanban.column-4",
    "5": "aven-kanban.column-5",
    "enter": "aven-kanban.go",
    "o": "aven-kanban.open",
    "a": "aven-kanban.answer",
    "shift-a": "aven-kanban.archive-all",
    "shift-s": "aven-kanban.ship",
    "shift-d": "aven-kanban.delete",
    "delete": "aven-kanban.delete",
    "x": "aven-kanban.archive",
    "d": "aven-kanban.dispatch",
    "u": "aven-kanban.summary",
    "s": "aven-kanban.plan-implement",
    "p": "aven-kanban.plan",
    "i": "aven-kanban.implement",
    "m": "aven-kanban.merge",
    "?": "aven-kanban.help",
    "shift-/": "aven-kanban.help",
    "r": "aven-kanban.refresh",
    "escape": "aven-kanban.close"
  }
}
